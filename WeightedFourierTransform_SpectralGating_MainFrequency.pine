var h18 = hline(spectrogram ? 18.5 : na, color = na, editable = false)
var h19 = hline(spectrogram ? 19.5 : na, color = na, editable = false)
var h20 = hline(spectrogram ? 20.5 : na, color = na, editable = false)
var h21 = hline(spectrogram ? 21.5 : na, color = na, editable = false)
var h22 = hline(spectrogram ? 22.5 : na, color = na, editable = false)
var h23 = hline(spectrogram ? 23.5 : na, color = na, editable = false)
var h24 = hline(spectrogram ? 24.5 : na, color = na, editable = false)
var h25 = hline(spectrogram ? 25.5 : na, color = na, editable = false)
var h26 = hline(spectrogram ? 26.5 : na, color = na, editable = false)
var h27 = hline(spectrogram ? 27.5 : na, color = na, editable = false)
var h28 = hline(spectrogram ? 28.5 : na, color = na, editable = false)
var h29 = hline(spectrogram ? 29.5 : na, color = na, editable = false)
var h30 = hline(spectrogram ? 30.5 : na, color = na, editable = false)
var h31 = hline(spectrogram ? 31.5 : na, color = na, editable = false)
var h32 = hline(spectrogram ? 32.5 : na, color = na, editable = false)
var h33 = hline(spectrogram ? 33.5 : na, color = na, editable = false)
var h34 = hline(spectrogram ? 34.5 : na, color = na, editable = false)
var h35 = hline(spectrogram ? 35.5 : na, color = na, editable = false)
var h36 = hline(spectrogram ? 36.5 : na, color = na, editable = false)
var h37 = hline(spectrogram ? 37.5 : na, color = na, editable = false)
var h38 = hline(spectrogram ? 38.5 : na, color = na, editable = false)
var h39 = hline(spectrogram ? 39.5 : na, color = na, editable = false)
var h40 = hline(spectrogram ? 40.5 : na, color = na, editable = false)
var h41 = hline(spectrogram ? 41.5 : na, color = na, editable = false)
var h42 = hline(spectrogram ? 42.5 : na, color = na, editable = false)
var h43 = hline(spectrogram ? 43.5 : na, color = na, editable = false)
var h44 = hline(spectrogram ? 44.5 : na, color = na, editable = false)
var h45 = hline(spectrogram ? 45.5 : na, color = na, editable = false)
var h46 = hline(spectrogram ? 46.5 : na, color = na, editable = false)
var h47 = hline(spectrogram ? 47.5 : na, color = na, editable = false)
var h48 = hline(spectrogram ? 48.5 : na, color = na, editable = false)
var h49 = hline(spectrogram ? 49.5 : na, color = na, editable = false)

fill(h00, h01, spectrogram ? _bin_color(0 ) : na, editable = false)
fill(h01, h02, spectrogram ? _bin_color(1 ) : na, editable = false)
fill(h02, h03, spectrogram ? _bin_color(2 ) : na, editable = false)
fill(h03, h04, spectrogram ? _bin_color(3 ) : na, editable = false)
